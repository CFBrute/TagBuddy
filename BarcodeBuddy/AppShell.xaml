<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarcodeBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:BarcodeBuddy.Pages"
    Title="Barcode Buddy">

    <TabBar>
        <ShellContent Title="Generate"
                      Icon="tab_generate.png"
                      Route="generate"
                      ContentTemplate="{DataTemplate pages:GeneratePage}" />
        <ShellContent Title="Favorites"
                      Icon="tab_favorites.png"
                      Route="favorites"
                      ContentTemplate="{DataTemplate pages:FavoritesPage}" />
        <ShellContent Title="Scan"
                      Icon="tab_scan.png"
                      Route="scan"
                      ContentTemplate="{DataTemplate pages:ScanPage}" />
    </TabBar>

</Shell>
