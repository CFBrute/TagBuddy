<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="BarcodeBuddy.Pages.ScanPage"
             Title="Scan">
    <Grid RowDefinitions="*,Auto">

        <zxing:CameraBarcodeReaderView x:Name="Camera"
                                       Grid.Row="0"
                                       IsDetecting="False"
                                       BarcodesDetected="OnBarcodesDetected" />

        <Label x:Name="PermissionLabel"
               Grid.Row="0"
               Text="Camera permission is needed to scan barcodes."
               IsVisible="False"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Padding="30"
               HorizontalTextAlignment="Center" />

        <Button x:Name="TorchButton"
                Grid.Row="0"
                Text="Torch"
                Clicked="OnTorch"
                BackgroundColor="#80000000"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="12" />

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="10">
            <Label x:Name="StatusLabel"
                   Text="Point the camera at a barcode"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="ResultLabel"
                   FontSize="18"
                   FontFamily="OpenSansSemibold"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
            <HorizontalStackLayout x:Name="ResultButtons" Spacing="10" HorizontalOptions="Center" IsVisible="False">
                <Button Text="Open in generator" Clicked="OnUseInGenerator" />
                <Button Text="Save" Clicked="OnSave" />
                <Button Text="Copy" Clicked="OnCopy" BackgroundColor="#6B7280" />
            </HorizontalStackLayout>
            <Button x:Name="ScanAgainButton"
                    Text="Scan again"
                    Clicked="OnScanAgain"
                    IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
