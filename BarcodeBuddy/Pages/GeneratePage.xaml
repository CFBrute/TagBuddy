<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BarcodeBuddy.Controls"
             x:Class="BarcodeBuddy.Pages.GeneratePage"
             Title="Generate">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Barcode type" FontAttributes="Bold" />
            <Picker x:Name="FormatPicker"
                    Title="Select a barcode type"
                    SelectedIndexChanged="OnFormatChanged" />
            <Label x:Name="HintLabel" FontSize="12" TextColor="Gray" />

            <Label Text="Text" FontAttributes="Bold" />
            <Entry x:Name="ValueEntry"
                   Placeholder="Type the text to encode"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="OnValueChanged" />

            <Label x:Name="ErrorLabel"
                   TextColor="#DC2626"
                   FontSize="13"
                   IsVisible="False" />

            <Border x:Name="BarcodeCard"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeThickness="1"
                    Padding="12"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBarcodeTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <controls:BarcodeView x:Name="Barcode"
                                          HeightRequest="140"
                                          HorizontalOptions="Fill"
                                          InputTransparent="True" />
                    <Label x:Name="ValueLabel"
                           HorizontalTextAlignment="Center"
                           TextColor="Black"
                           FontFamily="OpenSansSemibold" />
                    <Label Text="Tap to show full screen"
                           HorizontalTextAlignment="Center"
                           FontSize="11"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout x:Name="Actions" HorizontalOptions="Center" IsVisible="False">
                <Button Style="{StaticResource PrimaryIconButton}" ImageSource="ic_favorite.png"
                        Clicked="OnAddFavorite" SemanticProperties.Description="Add to favorites" ToolTipProperties.Text="Add to favorites" />
                <Button Style="{StaticResource IconButton}" ImageSource="ic_share.png"
                        Clicked="OnShare" SemanticProperties.Description="Share image" ToolTipProperties.Text="Share image" />
                <Button Style="{StaticResource IconButton}" ImageSource="ic_save.png"
                        Clicked="OnSaveImage" SemanticProperties.Description="Save image to gallery" ToolTipProperties.Text="Save image to gallery" />
                <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                        Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
