<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BarcodeBuddy.Controls"
             x:Class="BarcodeBuddy.Pages.QrPage"
             Title="Generate">
    <ScrollView x:Name="Scroller">
        <VerticalStackLayout Padding="20" Spacing="14">

            <!-- Paste replaces the whole content in one tap; Clear starts a fresh code. The multi-line editor has
                 no clear cross of its own, and select-all-then-delete is fiddly with a long link. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Content" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Paste" Clicked="OnPaste"
                        BackgroundColor="#6B7280" TextColor="White" Padding="14,6" MinimumHeightRequest="36" FontSize="13"
                        ToolTipProperties.Text="Replace the content with the clipboard" />
                <Button Grid.Column="2" x:Name="ClearButton" Text="Clear" Clicked="OnClear" IsVisible="False"
                        BackgroundColor="#6B7280" TextColor="White" Padding="14,6" MinimumHeightRequest="36" FontSize="13"
                        ToolTipProperties.Text="Start a new code" />
            </Grid>
            <Editor x:Name="ValueEditor"
                    Placeholder="Type a link, Wi-Fi details, a note..."
                    AutoSize="TextChanges"
                    MinimumHeightRequest="60"
                    TextChanged="OnValueChanged" />

            <Label x:Name="ErrorLabel"
                   TextColor="#DC2626"
                   FontSize="13"
                   IsVisible="False" />

            <!-- Options sit above the result so changing them never scrolls the result out of view -->
            <Button x:Name="AdvancedButton"
                    Text="Advanced options  ▸"
                    Clicked="OnToggleAdvanced"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Primary}}"
                    HorizontalOptions="Start"
                    Padding="0"
                    FontSize="14" />

            <VerticalStackLayout x:Name="AdvancedPanel" Spacing="12" IsVisible="False"
                                 Padding="12"
                                 BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">

                <Label Text="Error correction" FontAttributes="Bold" />
                <Label Text="More correction lets a damaged or partly covered code still scan, at the cost of a denser code. Pick H if you plan to print a logo over the middle."
                       FontSize="12" TextColor="Gray" />
                <Picker x:Name="EccPicker" SelectedIndexChanged="OnOptionsChanged" />

                <Label Text="Quiet zone" FontAttributes="Bold" />
                <Label Text="White margin around the code, in modules. The QR standard asks for 4; 2 is enough on a bright screen."
                       FontSize="12" TextColor="Gray" />
                <HorizontalStackLayout Spacing="12">
                    <Stepper x:Name="MarginStepper" Minimum="0" Maximum="4" Increment="1" Value="2"
                             ValueChanged="OnMarginChanged" />
                    <Label x:Name="MarginLabel" Text="2 modules" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="Encoding" FontAttributes="Bold" />
                <Label Text="Text is stored as UTF-8. Digits-only or uppercase-only content is packed more tightly automatically."
                       FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>

            <Border x:Name="QrCard"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeThickness="1"
                    Padding="0"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQrTapped" />
                </Border.GestureRecognizers>
                <!-- The exported image itself, rendered live, so the preview is exactly what gets shared -->
                <controls:PreviewView x:Name="PreviewImage" HorizontalOptions="Fill" InputTransparent="True" />
            </Border>

            <Label x:Name="InfoLabel"
                   HorizontalTextAlignment="Center"
                   FontSize="12"
                   TextColor="Gray"
                   IsVisible="False" />

            <!-- Text printed under the code in shared/saved images. Follows the content until edited.
                 Collapsed like the advanced options until someone wants to change it. -->
            <Grid x:Name="CaptionHeader" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" IsVisible="False">
                <Button Grid.Column="0" x:Name="CaptionToggle"
                        Text="Text under the image  ▸"
                        Clicked="OnToggleCaption"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Primary}}"
                        HorizontalOptions="Start"
                        Padding="0"
                        FontSize="14" />
                <Button Grid.Column="2" x:Name="CaptionResetButton" Text="Same as content" Clicked="OnCaptionReset" IsVisible="False"
                        BackgroundColor="#6B7280" TextColor="White" Padding="14,6" MinimumHeightRequest="36" FontSize="13" />
            </Grid>
            <!-- The panel with the (i) button straddling its top-left corner, half outside, half inside -->
            <Grid>
            <VerticalStackLayout x:Name="CaptionPanel" Spacing="10" IsVisible="False"
                                 Margin="0,14,0,0"
                                 Padding="12,16,12,12"
                                 BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                <Label x:Name="CaptionInfo" IsVisible="False" Margin="8,0,0,0"
                       Text="Printed under the code when you share or save the image. Change it, use several lines, or leave it empty for no text. Size and distance are fractions of the code's height; max width is how many code widths a line may use before it breaks. The − and + buttons step by 0.01 (0.1 for width)."
                       FontSize="12" TextColor="Gray" />
                <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0" Text="Position" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                        <Button x:Name="AlignLeftButton" Text="Left" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="AlignCenterButton" Text="Center" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="AlignRightButton" Text="Right" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                    </HorizontalStackLayout>
                    <!-- Each dial: a minus button, a slider, a plus button and the value. The buttons step by
                         0.01 (0.1 for width); the slider track is curved so the low end is easy to fine-tune. -->
                    <Label Grid.Row="1" Grid.Column="0" Text="Size" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="36,*,36,44" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="SizeMinus" Text="−" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Slider Grid.Column="1" x:Name="SizeSlider" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="SizePlus" Text="+" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Label Grid.Column="3" x:Name="SizeLabel" FontSize="13" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label Grid.Row="2" Grid.Column="0" Text="Distance" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="36,*,36,44" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="DistanceMinus" Text="−" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Slider Grid.Column="1" x:Name="DistanceSlider" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="DistancePlus" Text="+" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Label Grid.Column="3" x:Name="DistanceLabel" FontSize="13" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label Grid.Row="3" Grid.Column="0" Text="Max width" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="36,*,36,44" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="WidthMinus" Text="−" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Slider Grid.Column="1" x:Name="WidthSlider" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="WidthPlus" Text="+" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Label Grid.Column="3" x:Name="WidthLabel" FontSize="13" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                </Grid>
                <Label x:Name="WidthNote" FontSize="12" TextColor="Gray" IsVisible="False" />
                <Editor x:Name="CaptionEditor"
                        Placeholder="No text under the image"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="44"
                        HorizontalTextAlignment="Center"
                        TextChanged="OnCaptionChanged" />
            </VerticalStackLayout>
            <!-- (i): shows or hides the explanation at the top of the panel -->
            <Button x:Name="CaptionInfoButton" Text="i" Clicked="OnToggleCaptionInfo" IsVisible="False"
                    FontAttributes="Italic" FontFamily="OpenSansSemibold" FontSize="14"
                    WidthRequest="28" HeightRequest="28" MinimumHeightRequest="28" MinimumWidthRequest="28" CornerRadius="14" Padding="0"
                    BackgroundColor="#6B7280" TextColor="White"
                    HorizontalOptions="Start" VerticalOptions="Start" Margin="0"
                    SemanticProperties.Description="What these settings do" />
            </Grid>

            <HorizontalStackLayout x:Name="Actions" HorizontalOptions="Center" IsVisible="False">
                <Button Style="{StaticResource PrimaryIconButton}" ImageSource="ic_favorite.png"
                        Clicked="OnAddFavorite" SemanticProperties.Description="Add to favorites" ToolTipProperties.Text="Add to favorites" />
                <Button Style="{StaticResource IconButton}" ImageSource="ic_share.png"
                        Clicked="OnShare" SemanticProperties.Description="Share image" ToolTipProperties.Text="Share image" />
                <Button Style="{StaticResource IconButton}" ImageSource="ic_save.png"
                        Clicked="OnSaveImage" SemanticProperties.Description="Save image to gallery" ToolTipProperties.Text="Save image to gallery" />
                <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                        Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
            </HorizontalStackLayout>

            <!-- Spare room at the end while the caption section is open: when the card shrinks the page
                 would otherwise run out of scroll range and the controls would be pushed down under the finger. -->
            <ContentView x:Name="BottomSpacer" HeightRequest="0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
