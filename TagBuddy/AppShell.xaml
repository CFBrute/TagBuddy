<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TagBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TagBuddy.Pages"
    Title="Tag Buddy">

    <TabBar>
        <!-- Generate has two top tabs: QR codes first (most used), then linear barcodes -->
        <Tab Title="Generate"
             Icon="tab_generate.png"
             Route="generate">
            <ShellContent Title="QR Code"
                          Route="qr"
                          ContentTemplate="{DataTemplate pages:QrPage}" />
            <ShellContent Title="Barcode"
                          Route="barcode"
                          ContentTemplate="{DataTemplate pages:GeneratePage}" />
        </Tab>
        <ShellContent Title="Saved"
                      Icon="tab_saved.png"
                      Route="saved"
                      ContentTemplate="{DataTemplate pages:SavedPage}" />
        <ShellContent Title="Scan"
                      Icon="tab_scan.png"
                      Route="scan"
                      ContentTemplate="{DataTemplate pages:ScanPage}" />
        <ShellContent Title="NFC"
                      Icon="tab_nfc.png"
                      Route="nfc"
                      ContentTemplate="{DataTemplate pages:NfcPage}" />
        <!-- RF: reading over a Proxmark3 on USB (HF + LF). Hidden until one is plugged in; AppShell toggles it. -->
        <ShellContent Title="RF"
                      x:Name="RfTab"
                      Icon="tab_nfc.png"
                      Route="rf"
                      IsVisible="False"
                      ContentTemplate="{DataTemplate pages:ProxmarkPage}" />
        <!-- More has three top tabs: Settings first (used more often), then Help, then About -->
        <Tab x:Name="MoreTab"
             Title="More"
             Icon="tab_more.png"
             Route="more">
            <ShellContent Title="Settings"
                          Route="settings"
                          ContentTemplate="{DataTemplate pages:SettingsPage}" />
            <ShellContent Title="Help"
                          Route="help"
                          ContentTemplate="{DataTemplate pages:HelpPage}" />
            <ShellContent Title="About"
                          Route="about"
                          ContentTemplate="{DataTemplate pages:AboutPage}" />
        </Tab>
    </TabBar>

</Shell>
