<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TagBuddy.Controls"
             x:Class="TagBuddy.Pages.ShowBarcodePage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Padding="16">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

        <controls:BarcodeView x:Name="Barcode"
                              Grid.Row="0"
                              VerticalOptions="Center"
                              HorizontalOptions="Fill"
                              InputTransparent="True" />

        <Label x:Name="ValueLabel"
               Grid.Row="1"
               FontSize="22"
               FontFamily="OpenSansSemibold"
               TextColor="Black"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />

        <Label x:Name="NameLabel"
               Grid.Row="2"
               FontSize="14"
               TextColor="Gray"
               HorizontalTextAlignment="Center" />

        <controls:LinkPreviewView x:Name="Preview" Grid.Row="3" Compact="True" Margin="0,12,0,0" />

        <HorizontalStackLayout Grid.Row="4" HorizontalOptions="Center" Margin="0,16,0,0">
            <Button Style="{StaticResource IconButton}" ImageSource="ic_share.png"
                    Clicked="OnShare" SemanticProperties.Description="Share image" ToolTipProperties.Text="Share image" />
            <Button Style="{StaticResource IconButton}" ImageSource="ic_save.png"
                    Clicked="OnSaveImage" SemanticProperties.Description="Save image to gallery" ToolTipProperties.Text="Save image to gallery" />
            <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                    Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
        </HorizontalStackLayout>

        <!-- Screen brightness while the code is shown: starts at double the phone's own level (at least
             20 %, at most 100 %) and can be dragged either way -->
        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,44" ColumnSpacing="8" Margin="24,12,24,0">
            <Label Grid.Column="0" Text="Brightness" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
            <Slider Grid.Column="1" x:Name="BrightnessSlider" Minimum="0.05" Maximum="1" ValueChanged="OnBrightnessChanged"
                    MinimumTrackColor="{StaticResource Primary}" ThumbColor="{StaticResource Primary}" VerticalOptions="Center" />
            <Label Grid.Column="2" x:Name="BrightnessLabel" FontSize="12" TextColor="Gray" VerticalOptions="Center" HorizontalTextAlignment="End" />
        </Grid>

        <Label Grid.Row="6"
               Text="Tap anywhere to close"
               FontSize="12"
               TextColor="Gray"
               Margin="0,12,0,0"
               HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
