<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TagBuddy.Controls"
             x:Class="TagBuddy.Pages.ShowBarcodePage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Padding="16">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

        <controls:BarcodeView x:Name="Barcode"
                              Grid.Row="0"
                              VerticalOptions="Center"
                              HorizontalOptions="Fill"
                              InputTransparent="True" />

        <Label x:Name="ValueLabel"
               Grid.Row="1"
               FontSize="22"
               FontFamily="OpenSansSemibold"
               TextColor="Black"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />

        <Label x:Name="NameLabel"
               Grid.Row="2"
               FontSize="14"
               TextColor="Gray"
               HorizontalTextAlignment="Center" />

        <controls:LinkPreviewView x:Name="Preview" Grid.Row="3" Compact="True" Margin="0,12,0,0" />

        <HorizontalStackLayout Grid.Row="4" HorizontalOptions="Center" Margin="0,16,0,0">
            <Button Style="{StaticResource IconButton}" ImageSource="ic_share.png"
                    Clicked="OnShare" SemanticProperties.Description="Share image" ToolTipProperties.Text="Share image" />
            <Button Style="{StaticResource IconButton}" ImageSource="ic_save.png"
                    Clicked="OnSaveImage" SemanticProperties.Description="Save image to gallery" ToolTipProperties.Text="Save image to gallery" />
            <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                    Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
        </HorizontalStackLayout>

        <!-- Shown when the phone was dim on opening: the page went to half brightness instead of full -->
        <Button Grid.Row="5"
                x:Name="BrighterButton"
                Text="Full brightness"
                Clicked="OnBrighter"
                IsVisible="False"
                HorizontalOptions="Center"
                Margin="0,12,0,0"
                Padding="18,6"
                FontSize="13"
                BackgroundColor="#6B7280"
                TextColor="White" />

        <Label Grid.Row="6"
               Text="Tap anywhere to close"
               FontSize="12"
               TextColor="Gray"
               Margin="0,12,0,0"
               HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
