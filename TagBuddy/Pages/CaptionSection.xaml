<?xml version="1.0" encoding="utf-8" ?>
<!-- Text printed under the code in shared and saved images, for the QR and barcode generators. The text follows
     the content until edited. Collapsed until someone wants to change it. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TagBuddy.Pages.CaptionSection">
    <VerticalStackLayout Spacing="14">
        <Grid x:Name="CaptionHeader" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="CaptionToggle"
                    Text="Text under the image  ▸"
                    Clicked="OnToggle"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Primary}}"
                    HorizontalOptions="Start"
                    Padding="0"
                    FontSize="14" />
            <Button Grid.Column="2" x:Name="CaptionResetButton" Clicked="OnReset" IsVisible="False"
                    BackgroundColor="#6B7280" TextColor="White" Padding="14,6" MinimumHeightRequest="36" FontSize="13" />
        </Grid>
        <!-- The panel with the (i) button straddling its top-left corner, half outside, half inside -->
        <Grid>
            <VerticalStackLayout x:Name="CaptionPanel" Spacing="10" IsVisible="False"
                                 Margin="0,14,0,0"
                                 Padding="12,16,12,12"
                                 BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                <Label x:Name="CaptionInfo" IsVisible="False" Margin="8,0,0,0"
                       Text="Printed under the code when you share or save the image. Change it, use several lines, or leave it empty for no text. Size and distance are fractions of the code's height; max width is how many code widths a line may use before it breaks. The − and + buttons step by 0.01 (0.1 for width)."
                       FontSize="12" TextColor="Gray" />
                <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0" Text="Position" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                        <Button x:Name="AlignLeftButton" Text="Left" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="AlignCenterButton" Text="Center" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="AlignRightButton" Text="Right" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                    </HorizontalStackLayout>
                    <!-- Each dial: a minus button, a slider, a plus button and the value. The buttons step by
                         0.01 (0.1 for width); the slider track is curved so the low end is easy to fine-tune. -->
                    <Label Grid.Row="1" Grid.Column="0" Text="Size" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="36,*,36,44" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="SizeMinus" Text="−" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Slider Grid.Column="1" x:Name="SizeSlider" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="SizePlus" Text="+" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Label Grid.Column="3" x:Name="SizeLabel" FontSize="13" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label Grid.Row="2" Grid.Column="0" Text="Distance" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="36,*,36,44" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="DistanceMinus" Text="−" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Slider Grid.Column="1" x:Name="DistanceSlider" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="DistancePlus" Text="+" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Label Grid.Column="3" x:Name="DistanceLabel" FontSize="13" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label Grid.Row="3" Grid.Column="0" Text="Max width" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="36,*,36,44" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="WidthMinus" Text="−" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Slider Grid.Column="1" x:Name="WidthSlider" VerticalOptions="Center" />
                        <Button Grid.Column="2" x:Name="WidthPlus" Text="+" Padding="0" MinimumHeightRequest="34" FontSize="16" BackgroundColor="#6B7280" TextColor="White" />
                        <Label Grid.Column="3" x:Name="WidthLabel" FontSize="13" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                </Grid>
                <Label x:Name="WidthNote" FontSize="12" TextColor="Gray" IsVisible="False" />
                <Editor x:Name="CaptionEditor"
                        Placeholder="No text under the image"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="44"
                        HorizontalTextAlignment="Center"
                        TextChanged="OnTextChanged" />
            </VerticalStackLayout>
            <!-- (i): shows or hides the explanation at the top of the panel -->
            <Button x:Name="CaptionInfoButton" Text="i" Clicked="OnToggleInfo" IsVisible="False"
                    FontAttributes="Italic" FontFamily="OpenSansSemibold" FontSize="14"
                    WidthRequest="28" HeightRequest="28" MinimumHeightRequest="28" MinimumWidthRequest="28" CornerRadius="14" Padding="0"
                    BackgroundColor="#6B7280" TextColor="White"
                    HorizontalOptions="Start" VerticalOptions="Start" Margin="0"
                    SemanticProperties.Description="What these settings do" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
