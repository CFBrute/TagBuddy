<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TagBuddy.Pages.ScanPhotoPage"
             Title="Scanned picture"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="16" RowSpacing="12">

        <!-- The camera frame or picked picture the code was read from -->
        <Image x:Name="Photo"
               Grid.Row="0"
               Aspect="AspectFit"
               BackgroundColor="Black" />

        <Label x:Name="NameLabel"
               Grid.Row="1"
               FontSize="16"
               FontFamily="OpenSansSemibold"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />

        <Label x:Name="SummaryLabel"
               Grid.Row="2"
               FontSize="12"
               TextColor="Gray"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />

        <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="12">
            <Button Style="{StaticResource IconButton}" ImageSource="ic_share.png"
                    Clicked="OnShare" SemanticProperties.Description="Share picture" ToolTipProperties.Text="Share picture" />
            <Button Text="Delete picture" Clicked="OnDelete"
                    BackgroundColor="#6B7280" TextColor="White" Padding="14,6" MinimumHeightRequest="36" FontSize="13"
                    VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
