<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TagBuddy.Pages.DiffPage"
             Title="Compare tags">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="LeftLabel" FontSize="14" LineBreakMode="WordWrap" />
            <Label x:Name="RightLabel" FontSize="14" LineBreakMode="WordWrap" />
            <Label x:Name="SummaryLabel" FontSize="16" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" />
            <Label x:Name="Legend" FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />

            <!-- Only the segments that differ: each as two rows, left then right, the bytes that differ in colour -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111111}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView Orientation="Horizontal">
                    <Label x:Name="DiffLabel" FontFamily="monospace" FontSize="12" LineBreakMode="CharacterWrap" />
                </ScrollView>
            </Border>
            <Button Text="Copy as text" Clicked="OnCopy" BackgroundColor="#6B7280" TextColor="White" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
