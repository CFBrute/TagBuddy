<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TagBuddy.Pages.DiffPage"
             Title="Compare tags">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="LeftLabel" FontSize="14" LineBreakMode="WordWrap" />
            <Label x:Name="RightLabel" FontSize="14" LineBreakMode="WordWrap" />
            <Label x:Name="SummaryLabel" FontSize="16" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" />
            <Label x:Name="Legend" FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />

            <!-- Only the segments that differ: each as two rows, left then right, the bytes that differ in colour -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111111}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView Orientation="Horizontal">
                    <Label x:Name="DiffLabel" FontFamily="monospace" FontSize="12" LineBreakMode="CharacterWrap" />
                </ScrollView>
            </Border>
            <!-- Take the differing segments of one side into the editor for the other tag, as pending changes -->
            <Label x:Name="ApplyHint" FontSize="12" TextColor="Gray" LineBreakMode="WordWrap"
                   Text="Make one tag like the other: open the editor on it with the other side's bytes typed over the pages that differ, ready to write to that tag. Only the bytes shown; no keys, no rules." />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="ApplyLeftButton" Grid.Column="0" Text="Make left like right" Clicked="OnApplyLeft" />
                <Button x:Name="ApplyRightButton" Grid.Column="1" Text="Make right like left" Clicked="OnApplyRight" />
            </Grid>
            <Button Text="Copy as text" Clicked="OnCopy" BackgroundColor="#6B7280" TextColor="White" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
