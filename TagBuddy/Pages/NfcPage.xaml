<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TagBuddy.Controls"
             x:Class="TagBuddy.Pages.NfcPage"
             Title="NFC">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Read / Write mode switch, in the QR/Barcode top-tab style but each filling half the width -->
            <Grid ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Button x:Name="ReadModeButton" Text="Read a tag" Clicked="OnReadMode"
                            BackgroundColor="Transparent" BorderWidth="0" FontSize="15" Padding="0,8" />
                    <BoxView x:Name="ReadUnderline" HeightRequest="3" Color="Transparent" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Button x:Name="WriteModeButton" Text="Write a tag" Clicked="OnWriteMode"
                            BackgroundColor="Transparent" BorderWidth="0" FontSize="15" Padding="0,8" />
                    <BoxView x:Name="WriteUnderline" HeightRequest="3" Color="Transparent" />
                </VerticalStackLayout>
            </Grid>

            <!-- Shown only once a protected tag is noticed (reading or writing); never a thing to set up in advance. -->
            <VerticalStackLayout x:Name="PasswordPanel" Spacing="8" IsVisible="False"
                                 Padding="12" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                <Label x:Name="PasswordInfo" FontSize="13" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="6">
                    <Button x:Name="HexModeButton" Text="Hex" Clicked="OnPasswordHexMode"
                            Padding="14,4" MinimumHeightRequest="34" FontSize="13" />
                    <Button x:Name="TextModeButton" Text="Text" Clicked="OnPasswordTextMode"
                            Padding="14,4" MinimumHeightRequest="34" FontSize="13" />
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="PasswordEntry" Placeholder="8 hex digits, e.g. FFFFFFFF" MaxLength="11"
                           TextChanged="OnPasswordChanged" />
                    <Button x:Name="PasswordDefaultButton" Grid.Column="1" Text="FFFFFFFF" Clicked="OnPasswordDefault"
                            BackgroundColor="#6B7280" TextColor="White" FontSize="12" Padding="10,4" />
                </Grid>
                <Label x:Name="PasswordFormatHint" FontSize="12" TextColor="Gray"
                       Text="A tag's password is 4 bytes, shown as 8 hex digits; a new NTAG/Ultralight's factory password is FFFFFFFF. It is kept only while this tab is open." />
                <Label FontSize="12" TextColor="#DC2626"
                       Text="Warning: some tags lock for good after a few wrong passwords. Only enter one you know." />
                <!-- One-shot default attempt, shown only when the automatic setting is off (see Settings) -->
                <Button x:Name="TryDefaultButton" Text="Try the factory default (FFFFFFFF) on the next read" IsVisible="False"
                        Clicked="OnTryDefaultOnce" Padding="12,6" MinimumHeightRequest="38" FontSize="13" />
            </VerticalStackLayout>

            <!-- MIFARE Classic sector key, shown only when some sectors stayed locked after the default keys. -->
            <VerticalStackLayout x:Name="ClassicKeyPanel" Spacing="8" IsVisible="False"
                                 Padding="12" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                <Label Text="Some sectors use a custom key" FontSize="13" FontAttributes="Bold" />
                <Entry x:Name="ClassicKeyEntry" Placeholder="12 hex digits, e.g. A0A1A2A3A4A5" MaxLength="17"
                       TextChanged="OnClassicKeyChanged" />
                <Label FontSize="12" TextColor="Gray"
                       Text="A MIFARE Classic key is 6 bytes (12 hex digits). Enter one and hold the card again to open the sectors it unlocks. Trying a wrong key is safe: Classic cards have no wrong-key lockout. The key is kept only while this tab is open." />

                <!-- Run a whole imported dictionary against the locked sectors; keys that open a card are remembered -->
                <VerticalStackLayout x:Name="KeyDictionaryPanel" Spacing="8" IsVisible="False" Margin="0,4,0,0">
                    <Button x:Name="TryAllKeysButton" Text="Try all default keys" Clicked="OnTryAllKeys"
                            Padding="12,6" MinimumHeightRequest="38" FontSize="13" />
                    <Button Text="Import a key file (.dic / .txt)" Clicked="OnImportKeys"
                            BackgroundColor="#6B7280" TextColor="White" Padding="12,6" MinimumHeightRequest="38" FontSize="13" />
                    <Label x:Name="KeyStoreStatus" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===================== READ ===================== -->
            <VerticalStackLayout x:Name="ReadSection" Spacing="12">

                <!-- Waiting state -->
                <VerticalStackLayout x:Name="WaitingPanel" Spacing="12" Padding="0,30,0,20">
                    <Image Source="tab_nfc.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" Opacity="0.6" />
                    <Label x:Name="StatusLabel"
                           Text="Hold a tag or card against the back of the phone"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="HintLabel"
                           Text="Works with NFC stickers, access cards, transit and bank cards and ID documents. Content shows when the tag carries a link or text; protected cards show only their type and serial number."
                           FontSize="12" TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="SettingsButton"
                            Text="Turn on NFC"
                            Clicked="OnOpenSettings"
                            HorizontalOptions="Center"
                            IsVisible="False" />
                </VerticalStackLayout>

                <!-- Result -->
                <VerticalStackLayout x:Name="ResultPanel" Spacing="12" IsVisible="False">
                    <Label x:Name="TagTitle"
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ContentLabel"
                           FontSize="18"
                           FontFamily="OpenSansSemibold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <!-- Private text on the tag: opened with its passphrase, on this phone -->
                    <VerticalStackLayout x:Name="UnlockPanel" Spacing="8" IsVisible="False">
                        <Label x:Name="UnlockStatus" FontSize="13" TextColor="Gray" HorizontalTextAlignment="Center" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="UnlockEntry" Placeholder="Passphrase" IsPassword="True" Completed="OnUnlock" />
                            <Button Grid.Column="1" Text="Unlock" Clicked="OnUnlock" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentActions" Spacing="12" IsVisible="False">
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Button Style="{StaticResource PrimaryIconButton}" ImageSource="ic_bookmark.png"
                                    Clicked="OnSave" SemanticProperties.Description="Save as text" ToolTipProperties.Text="Save as text" />
                            <Button Style="{StaticResource IconButton}" ImageSource="ic_copy.png"
                                    Clicked="OnCopy" SemanticProperties.Description="Copy text" ToolTipProperties.Text="Copy text" />
                            <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                                    Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
                        </HorizontalStackLayout>
                        <!-- What another app can do with it, in words (not for web links) -->
                        <Button x:Name="HandoffButton" Clicked="OnOpenLink" IsVisible="False" HorizontalOptions="Center" />
                        <Button x:Name="ViewPageButton" Text="View page" Clicked="OnViewPage" IsVisible="False"
                                HorizontalOptions="Center" />
                        <controls:LinkPreviewView x:Name="Preview" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Details" Spacing="4"
                                         Padding="12"
                                         BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}" />

                    <!-- Readable memory: every page of a Type 2 tag, or the opened sectors of a MIFARE Classic card -->
                    <VerticalStackLayout x:Name="MemoryPanel" Spacing="8" IsVisible="False">
                        <Label x:Name="MemoryTitle" Text="Readable memory"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="MemoryDescription" Text="Every page of this tag's memory. Save it as a binary dump to keep a backup that can be written back to the tag later."
                               FontSize="12" TextColor="Gray"
                               HorizontalTextAlignment="Center" />

                        <!-- Opens the write tab with these pages or blocks to edit, expecting this same tag -->
                        <Button x:Name="EditTagButton" Text="Edit and write to this tag" Clicked="OnEditTag"
                                IsVisible="False" />
                        <!-- Keeps the tag in Saved as it was read, to view again or edit and write back -->
                        <Button x:Name="SaveTagButton" Text="Save tag as read" Clicked="OnSaveDump" IsVisible="False"
                                BackgroundColor="#6B7280" TextColor="White" />
                        <!-- Against a saved read of the same kind of tag, or the next tag held to the phone -->
                        <Button x:Name="CompareButton" Text="Compare with…" Clicked="OnCompare" IsVisible="False"
                                BackgroundColor="#6B7280" TextColor="White" />
                        <Label x:Name="CompareHint" FontSize="12" TextColor="#F5A623" IsVisible="False" HorizontalTextAlignment="Center" />
                        <Grid x:Name="DumpButtons" ColumnDefinitions="*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Share .bin file" Clicked="OnShareDump"
                                    BackgroundColor="#6B7280" TextColor="White" />
                        </Grid>

                        <!-- Which pages are writable, behind the password, locked, one-time or fixed (MemoryMapView) -->
                        <Label x:Name="MemoryOverview" FontSize="13" LineHeight="1.2" />

                        <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#111111}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <!-- Scrolls sideways so a long block line keeps its columns instead of wrapping. -->
                            <!-- CharacterWrap, not NoWrap: NoWrap collapses a multi-line label to one line on Android.
                                 The horizontal scroll gives unbounded width, so no line actually wraps. -->
                            <ScrollView Orientation="Horizontal">
                                <Label x:Name="MemoryLabel"
                                       FontFamily="monospace"
                                       FontSize="12"
                                       LineBreakMode="CharacterWrap" />
                            </ScrollView>
                        </Border>
                        <Button Text="Copy memory as text" Clicked="OnCopyMemory"
                                BackgroundColor="#6B7280" TextColor="White" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Label Text="Hold another tag to read it"
                           FontSize="12" TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===================== WRITE ===================== -->
            <VerticalStackLayout x:Name="WriteSection" Spacing="12" IsVisible="False">

                <Label Text="What to write" FontAttributes="Bold" />
                <Picker x:Name="WriteTypePicker" SelectedIndexChanged="OnWriteTypeChanged">
                    <Picker.Items>
                        <x:String>Auto (link or text)</x:String>
                        <x:String>Link</x:String>
                        <x:String>Plain text</x:String>
                        <x:String>Contact (vCard)</x:String>
                        <x:String>Private text (passphrase)</x:String>
                        <x:String>Raw bytes (no NDEF)</x:String>
                        <x:String>Edit pages or blocks (hex, text)</x:String>
                        <x:String>Binary dump (Amiibo, backup)</x:String>
                        <x:String>Erase tag (reset)</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Text content: link, text, vCard -->
                <VerticalStackLayout x:Name="TextPanel" Spacing="12">
                    <Editor x:Name="WriteEditor"
                            Placeholder="Type a link, text, or paste a vCard; or load a favorite"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            TextChanged="OnWriteTextChanged" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Load from Saved" Clicked="OnLoadFavorite"
                                BackgroundColor="#6B7280" TextColor="White" />
                        <Button Text="Clear" Clicked="OnClearEditor"
                                BackgroundColor="#6B7280" TextColor="White" />
                    </HorizontalStackLayout>

                    <!-- Private text: the passphrase it is encrypted with, typed twice; never stored -->
                    <VerticalStackLayout x:Name="PrivatePanel" Spacing="8" IsVisible="False">
                        <Entry x:Name="PassphraseEntry" Placeholder="Passphrase (at least 8 characters)" IsPassword="True"
                               TextChanged="OnWriteTextChanged" />
                        <Entry x:Name="RepeatEntry" Placeholder="The same passphrase again" IsPassword="True"
                               TextChanged="OnWriteTextChanged" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Segment editor: chosen pages or blocks, in hex or text, for the tag it expects -->
                <VerticalStackLayout x:Name="SegmentPanel" Spacing="10" IsVisible="False">
                    <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="12"
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label x:Name="ExpectSummary" FontSize="13" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <Button x:Name="ExpectToggle" Grid.Column="1" Text="Change" Clicked="OnToggleExpect"
                                        BackgroundColor="#6B7280" TextColor="White" FontSize="12" Padding="10,4" MinimumHeightRequest="32" />
                            </Grid>
                            <VerticalStackLayout x:Name="ExpectDetails" Spacing="6" IsVisible="False">
                                <Label Text="Tag type" FontSize="12" TextColor="Gray" />
                                <Picker x:Name="SegmentTypePicker" SelectedIndexChanged="OnSegmentTypeChanged" />
                                <Label Text="Expected serial number (leave empty for any tag)" FontSize="12" TextColor="Gray" />
                                <Entry x:Name="ExpectedIdEntry" Placeholder="e.g. 04:A1:B2:C3:D4:E5:F6" TextChanged="OnExpectedIdChanged" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label x:Name="RangeFromLabel" Text="From page" FontSize="12" TextColor="Gray" />
                                        <Entry x:Name="RangeFromEntry" Keyboard="Numeric" TextChanged="OnRangeChanged" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label x:Name="RangeToLabel" Text="To page" FontSize="12" TextColor="Gray" />
                                        <Entry x:Name="RangeToEntry" Keyboard="Numeric" TextChanged="OnRangeChanged" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="SegmentSizePanel" Grid.Column="2" Spacing="2">
                                        <Label Text="Bytes per block" FontSize="12" TextColor="Gray" />
                                        <Entry x:Name="SegmentSizeEntry" Keyboard="Numeric" TextChanged="OnSegmentSizeChanged" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label x:Name="ExpectHint" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Two tabs (MIFARE Classic): edit the bytes, or change the cursor sector's keys and rules, so
                         sector settings are not a long scroll past every block. -->
                    <HorizontalStackLayout x:Name="SegmentTabBar" Spacing="20" IsVisible="False">
                        <VerticalStackLayout Spacing="0">
                            <Button x:Name="EditTabButton" Text="Edit" Clicked="OnEditTabSelected"
                                    BackgroundColor="Transparent" BorderWidth="0" Padding="2,6" FontSize="14" />
                            <BoxView x:Name="EditUnderline" HeightRequest="3" Color="Transparent" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Button x:Name="SectorsTabButton" Text="Sector keys &amp; rules" Clicked="OnSectorsTabSelected"
                                    BackgroundColor="Transparent" BorderWidth="0" Padding="2,6" FontSize="14" />
                            <BoxView x:Name="SectorsUnderline" HeightRequest="3" Color="Transparent" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <VerticalStackLayout x:Name="EditTab" Spacing="10">
                    <!-- The edit history: back and forward in time, and the byte under the cursor back as the tag had
                         it, then one byte left (resets by place, where Undo goes by time). Tapping a byte's hex or its
                         text picks which column typing goes to. -->
                    <HorizontalStackLayout Spacing="6">
                        <Button x:Name="SegmentUndoButton" Text="↶ Undo" Clicked="OnSegmentUndo"
                                BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="SegmentRedoButton" Text="↷ Redo" Clicked="OnSegmentRedo"
                                BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="SegmentResetButton" Text="◀ Reset byte" Clicked="OnSegmentResetByte"
                                BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                    </HorizontalStackLayout>
                    <!-- Wholesale changes: the cursor's segment or every writable segment in the range to 00, or every
                         change dropped -->
                    <HorizontalStackLayout Spacing="6">
                        <Button x:Name="SegmentZeroRowButton" Text="Row to 00" Clicked="OnSegmentZeroRow"
                                BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="SegmentZeroAllButton" Text="All to 00" Clicked="OnSegmentZeroAll"
                                BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                        <Button x:Name="SegmentRevertButton" Text="Revert" Clicked="OnSegmentRevert"
                                BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                    </HorizontalStackLayout>

                    <!-- Block 0 (the UID) is never written on a normal card; a magic/clone card lets it be rewritten.
                         Off by default, shown only for a MIFARE Classic card that was read. Sits above the grid so it
                         is to hand without scrolling the long list of blocks. -->
                    <HorizontalStackLayout x:Name="BlockZeroPanel" Spacing="8" IsVisible="False">
                        <Switch x:Name="BlockZeroSwitch" Toggled="OnBlockZeroToggled" VerticalOptions="Center" />
                        <Label VerticalOptions="Center" FontSize="12" TextColor="Gray" MaximumWidthRequest="330"
                               Text="Edit block 0 (the UID) — only a magic/clone card can take it; a normal card refuses the write. A wrong check byte (BCC) can make the card unreadable." />
                    </HorizontalStackLayout>

                    <!-- The pages or blocks, laid out like the read view; tap a byte to put the cursor there -->
                    <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="4"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#111111}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <ScrollView Orientation="Horizontal">
                            <Grid>
                                <!-- Takes the keyboard's typing for the grid. Never seen; it moves to the cursor's row so
                                     Android keeps that row in view above the keyboard. -->
                                <Entry x:Name="SegmentInput" Opacity="0.01" WidthRequest="40" HeightRequest="40"
                                       HorizontalOptions="Start" VerticalOptions="Start"
                                       Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                       TextChanged="OnSegmentInput" Completed="OnSegmentInputCompleted" />
                                <controls:SegmentGrid x:Name="SegmentGrid" HorizontalOptions="Start" VerticalOptions="Start" />
                            </Grid>
                        </ScrollView>
                    </Border>
                    <Label x:Name="SegmentHint" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>

                    <!-- Sector keys & rules tab: settings for one sector, chosen here or by tapping a block in Edit. -->
                    <VerticalStackLayout x:Name="SectorsTab" Spacing="10" IsVisible="False">
                    <Label x:Name="SectorsEmptyLabel" FontSize="13" TextColor="Gray" IsVisible="False"
                           Text="No sector opened, so none can be changed. Read the card with the right keys first." />

                    <!-- Pick which sector to view and change (the sectors a key opened); also follows the Edit cursor. -->
                    <VerticalStackLayout x:Name="SectorChoosePanel" Spacing="2" IsVisible="False">
                        <Label Text="Sector" FontSize="12" TextColor="Gray" />
                        <Picker x:Name="SectorPicker" FontSize="14" SelectedIndexChanged="OnSectorPicked" />
                    </VerticalStackLayout>

                    <!-- A key of the person's own for the cursor's sector, offered only for a sector that opened with a default key -->
                    <VerticalStackLayout x:Name="SectorKeyPanel" Spacing="6" IsVisible="False"
                                         Padding="12" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                        <Label x:Name="SectorKeyTitle" FontSize="13" FontAttributes="Bold" />

                        <!-- Key A and key B as one row each, edited like a row of the Edit tab: tap a byte's hex or its
                             text and type over it. They are the trailer row's own bytes, so the two stay in step.
                             Typing can be done only when the sector opened and the rules still let the keys change. -->
                        <VerticalStackLayout x:Name="SectorKeysPanel" Spacing="6">
                            <Label x:Name="KeysLockedLabel" FontSize="12" TextColor="#DC2626" IsVisible="False"
                                   Text="The sector's rules lock its keys, so they cannot be changed." />
                            <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="4" HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111111}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid>
                                    <!-- Takes the keyboard's typing for the two key rows; never seen -->
                                    <Entry x:Name="SectorKeyInput" Opacity="0.01" WidthRequest="40" HeightRequest="40"
                                           HorizontalOptions="Start" VerticalOptions="Start"
                                           Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                           TextChanged="OnSegmentInput" Completed="OnSegmentInputCompleted" />
                                    <VerticalStackLayout Spacing="0">
                                        <controls:SegmentGrid x:Name="SectorKeyAGrid" HorizontalOptions="Start" />
                                        <controls:SegmentGrid x:Name="SectorKeyBGrid" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Label x:Name="KeyASpareLabel" FontSize="11" TextColor="Gray" IsVisible="False"
                                   Text="Key A is not used as a key by the rules — its six bytes are free to store data." />
                            <Label x:Name="SectorKeyHint" FontSize="12" TextColor="Gray"
                                   Text="Tap a key's hex and type 12 hex digits, or tap its text and type 6 characters; typing runs on from key A into key B. Key A reads back as 00, so only the bytes you type are written and an untouched key is kept. Set both the same for one new key. The phone remembers a new key for this tag — keep a copy, or the sector cannot be opened on another phone." />
                        </VerticalStackLayout>

                        <!-- The sector's rules, as read; pick another to change them. Built from the choice, never typed as bytes. -->
                        <VerticalStackLayout x:Name="SectorRulesPanel" Spacing="4">
                            <Label Text="Rules" FontSize="13" FontAttributes="Bold" Margin="0,6,0,0" />
                            <Label FontSize="12" TextColor="Gray"
                                   Text="What key A and key B may do. The tag enforces these: a write the rules do not allow is refused. They are shown as the tag has them; pick another to change them with the next write." />
                            <Label x:Name="RulesUnknownLabel" FontSize="12" TextColor="#DC2626" IsVisible="False"
                                   Text="This sector's rules could not be read or are corrupt, so they cannot be changed here." />
                            <!-- One choice that sets all three data blocks of this sector at once -->
                            <Label Text="All data blocks in this sector" FontSize="12" TextColor="Gray" Margin="0,2,0,0" />
                            <Picker x:Name="AllBlocksPicker" FontSize="13" SelectedIndexChanged="OnAllBlocksRuleChanged" />
                            <Label Text="…or set each block on its own" FontSize="12" TextColor="Gray" Margin="0,4,0,0" />
                            <Label x:Name="DataRule0Label" FontSize="12" TextColor="Gray" />
                            <Picker x:Name="DataRule0Picker" FontSize="13" SelectedIndexChanged="OnSectorRuleChanged" />
                            <Label x:Name="DataRule1Label" FontSize="12" TextColor="Gray" />
                            <Picker x:Name="DataRule1Picker" FontSize="13" SelectedIndexChanged="OnSectorRuleChanged" />
                            <Label x:Name="DataRule2Label" FontSize="12" TextColor="Gray" />
                            <Picker x:Name="DataRule2Picker" FontSize="13" SelectedIndexChanged="OnSectorRuleChanged" />
                            <Label Text="The keys and these rules" FontSize="12" TextColor="Gray" />
                            <Picker x:Name="TrailerRulePicker" FontSize="13" SelectedIndexChanged="OnSectorRuleChanged" />
                            <Label x:Name="PermanentWarning" FontSize="12" TextColor="#DC2626" IsVisible="False"
                                   Text="⚠ The chosen rule for the keys is permanent: once written, nothing in this sector can ever be changed again." />
                        </VerticalStackLayout>
                        <Label x:Name="SectorKeyList" FontSize="12" />
                    </VerticalStackLayout>

                    <!-- The same keys, or the same data-block rule, on every sector that opened -->
                    <VerticalStackLayout x:Name="AllSectorsPanel" Spacing="6" Padding="12" IsVisible="False"
                                         BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                        <Label Text="All sectors at once" FontSize="13" FontAttributes="Bold" />
                        <Label Text="Keys" FontSize="12" TextColor="Gray" />
                        <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="4" HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#111111}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid>
                                <Entry x:Name="AllKeysInput" Opacity="0.01" WidthRequest="40" HeightRequest="40"
                                       HorizontalOptions="Start" VerticalOptions="Start"
                                       Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                       TextChanged="OnSegmentInput" Completed="OnSegmentInputCompleted" />
                                <VerticalStackLayout Spacing="0">
                                    <controls:SegmentGrid x:Name="AllKeyAGrid" HorizontalOptions="Start" />
                                    <controls:SegmentGrid x:Name="AllKeyBGrid" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <HorizontalStackLayout Spacing="6">
                            <Button x:Name="AllKeysApplyButton" Text="Set on every sector" Clicked="OnAllKeysApply"
                                    BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                            <Button x:Name="AllKeysClearButton" Text="Clear" Clicked="OnAllKeysClear"
                                    BackgroundColor="#6B7280" TextColor="White" Padding="10,4" MinimumHeightRequest="34" FontSize="13" />
                        </HorizontalStackLayout>
                        <Label x:Name="AllKeysHint" FontSize="12" TextColor="Gray" />
                        <Label Text="Rule for every data block" FontSize="12" TextColor="Gray" Margin="0,6,0,0" />
                        <Label FontSize="12" TextColor="Gray"
                               Text="Sets the same rule on every data block of every sector that opened. Each sector's trailer rule and keys are left as they are." />
                        <Picker x:Name="AllSectorsPicker" FontSize="13" SelectedIndexChanged="OnAllSectorsRuleChanged" />
                    </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Writes already on a tag: put the old bytes back, or write the change again -->
                    <VerticalStackLayout x:Name="TagHistoryPanel" Spacing="6" IsVisible="False">
                        <Label x:Name="TagHistoryLabel" FontSize="13" />
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="TagUndoButton" Text="Undo on the tag" Clicked="OnTagUndo"
                                    BackgroundColor="#6B7280" TextColor="White" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                            <Button x:Name="TagRedoButton" Text="Redo on the tag" Clicked="OnTagRedo"
                                    BackgroundColor="#6B7280" TextColor="White" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                            <Button x:Name="TagStepCancelButton" Text="Cancel" Clicked="OnTagStepCancel" IsVisible="False"
                                    BackgroundColor="#6B7280" TextColor="White" Padding="12,4" MinimumHeightRequest="34" FontSize="13" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Binary dump: restore a saved tag image -->
                <VerticalStackLayout x:Name="DumpPanel" Spacing="12" IsVisible="False">
                    <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="12"
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label x:Name="DumpLabel"
                               Text="No dump chosen"
                               FontSize="14"
                               LineBreakMode="WordWrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Button Grid.Row="0" Grid.Column="0" Text="Choose saved dump" Clicked="OnChooseDump" />
                        <Button Grid.Row="0" Grid.Column="1" Text="Import .bin file" Clicked="OnImportDump"
                                BackgroundColor="#6B7280" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="0" Text="Paste hex" Clicked="OnPasteHex"
                                BackgroundColor="#6B7280" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="1" Text="Delete a saved dump" Clicked="OnDeleteDump"
                                BackgroundColor="#6B7280" TextColor="White" />
                    </Grid>

                    <Label x:Name="DumpHint" Text="Writes page 3 and every user page of the dump to an NTAG or Ultralight tag. The serial number (pages 0-2) and the permanent lock bits are never written, so the tag stays rewritable. An Amiibo dump also gets the Nintendo password set from this tag's serial. Amiibo data is tied to the serial it was made for, so write it back to the same tag."
                           FontSize="12" TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Erase -->
                <VerticalStackLayout x:Name="ErasePanel" Spacing="12" IsVisible="False">
                    <Label x:Name="EraseHint" Text="Clears every user page of the tag (all zeros with an empty NDEF message) and removes password protection when the tag uses the Amiibo key. The serial number and one-time pages are untouched. Save a dump first if you may want the content back."
                           FontSize="12" TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Label x:Name="WriteStatus"
                       Text="Enter content, then hold a writable tag to the back of the phone"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0" />
                <!-- Shown when a text write met a tag that cannot hold NDEF (an Amiibo tag, say): one tap to write it as raw bytes -->
                <Button x:Name="UseRawButton" Text="Write it as raw bytes instead" Clicked="OnUseRaw" IsVisible="False"
                        HorizontalOptions="Center" />

                <Label x:Name="WriteHint"
                       Text="Writes NDEF content to writable tags only (NTAG, Ultralight and other NDEF tags). The tag's serial number is fixed and is never changed. Locked cards cannot be written."
                       FontSize="12" TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
