<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:controls="clr-namespace:TagBuddy.Controls"
             x:Class="TagBuddy.Pages.ScanPage"
             Title="Scan">
    <Grid x:Name="Root" RowDefinitions="*,Auto">

        <!-- Camera area. The camera view is created when scanning starts and removed when a result is shown,
             which releases the camera. -->
        <Grid x:Name="CameraArea" Grid.Row="0">
            <ContentView x:Name="CameraHost" />

            <!-- Viewfinder over the live camera: a dimmed frame around the square where the code should be. Its
                 corners turn amber when something code-like is seen and flash green on a read. Tap to focus. -->
            <GraphicsView x:Name="Viewfinder" BackgroundColor="Transparent" InputTransparent="False" IsVisible="False">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnViewfinderTapped" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
            <Border x:Name="HintBorder"
                    BackgroundColor="#80000000"
                    StrokeThickness="0"
                    Padding="10,6"
                    Margin="16,0,16,16"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    InputTransparent="True"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label x:Name="HintLabel"
                       Text="Hold the code inside the square"
                       TextColor="White"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </Border>

            <!-- The picture chosen with "From image", shown while it is analysed and next to its result -->
            <Image x:Name="PickedImage"
                   Aspect="AspectFit"
                   BackgroundColor="Black"
                   IsVisible="False" />

            <!-- Shown over the picture while the decoder works on it -->
            <Grid x:Name="AnalysingOverlay" BackgroundColor="#99000000" IsVisible="False">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                    <ActivityIndicator x:Name="AnalysingSpinner"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="64" HeightRequest="64" />
                    <Label Text="Looking for a code in the picture..."
                           TextColor="White"
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Label x:Name="PermissionLabel"
                   Text="Camera permission is needed to scan codes."
                   IsVisible="False"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="30"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout x:Name="CameraButtons" HorizontalOptions="End" VerticalOptions="Start" Margin="12" Spacing="8">
                <Button Text="From image"
                        Clicked="OnPickImage"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        ToolTipProperties.Text="Read a code from a picture on the phone" />
                <Button x:Name="TorchButton"
                        Text="Torch"
                        Clicked="OnTorch"
                        BackgroundColor="#80000000"
                        TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <ScrollView x:Name="ResultScroll" Grid.Row="1" MaximumHeightRequest="160">
            <VerticalStackLayout Padding="20" Spacing="12">

                <!-- Shown once a result exists: camera is off, these bring it back or read another picture -->
                <Grid x:Name="ResultTopBar" ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="False">
                    <Button Grid.Column="0" Text="Scan again" Clicked="OnScanAgain" />
                    <Button Grid.Column="1" Text="From image" Clicked="OnPickImage" BackgroundColor="#6B7280" TextColor="White" />
                </Grid>

                <Label x:Name="StatusLabel"
                       Text="Point the camera at a barcode or QR code"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="ResultLabel"
                       FontSize="18"
                       FontFamily="OpenSansSemibold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <VerticalStackLayout x:Name="ResultButtons" Spacing="12" IsVisible="False">
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Button Style="{StaticResource PrimaryIconButton}" ImageSource="ic_bookmark.png"
                                Clicked="OnSave" SemanticProperties.Description="Save" ToolTipProperties.Text="Save" />
                        <Button Style="{StaticResource IconButton}" ImageSource="ic_copy.png"
                                Clicked="OnCopy" SemanticProperties.Description="Copy text" ToolTipProperties.Text="Copy text" />
                        <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                                Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
                    </HorizontalStackLayout>
                    <!-- What another app can do with it, in words: "Sign in with passkey", "Join Wi-Fi network", ... (not for web links, which have the icon and View page) -->
                    <Button x:Name="HandoffButton" Clicked="OnOpenLink" IsVisible="False" HorizontalOptions="Center" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button x:Name="ViewPageButton" Text="View page" Clicked="OnViewPage" IsVisible="False" />
                        <Button Text="Open in generator" Clicked="OnUseInGenerator"
                                BackgroundColor="#6B7280" TextColor="White" />
                    </HorizontalStackLayout>
                    <controls:LinkPreviewView x:Name="Preview" />
                </VerticalStackLayout>

                <!-- Details about the scanned code (format, content kind, error correction, ...) -->
                <VerticalStackLayout x:Name="Details" Spacing="4" IsVisible="False"
                                     Padding="12"
                                     BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
