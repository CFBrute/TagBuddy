<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TagBuddy.Pages.WebPage"
             Title="Page"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="12,8"
              BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A2A}">
            <Label x:Name="UrlLabel"
                   Grid.Column="0"
                   FontSize="12"
                   TextColor="Gray"
                   VerticalOptions="Center"
                   LineBreakMode="MiddleTruncation" />
            <Button Grid.Column="1" Text="Reload" Clicked="OnReload" FontSize="12" Padding="10,4"
                    BackgroundColor="#6B7280" TextColor="White" />
            <Button Grid.Column="2" Text="Browser" Clicked="OnOpenExternal" FontSize="12" Padding="10,4"
                    BackgroundColor="#6B7280" TextColor="White" />
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="1" IsVisible="False" Progress="0.3" />

        <WebView x:Name="Web"
                 Grid.Row="2"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated" />
    </Grid>
</ContentPage>
