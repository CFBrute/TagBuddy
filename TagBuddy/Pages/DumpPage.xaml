<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TagBuddy.Pages.DumpPage"
             Title="Tag dump">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="NameLabel" FontSize="18" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" />
            <Label x:Name="SummaryLabel" FontSize="13" TextColor="Gray" LineBreakMode="WordWrap" />

            <Label Text="Readable text" FontAttributes="Bold" />
            <Label x:Name="TextLabel" FontSize="14" LineBreakMode="WordWrap" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Write to a tag" Clicked="OnWrite" />
                <Button Text="Share .bin" Clicked="OnShare" BackgroundColor="#6B7280" TextColor="White" />
                <Button Text="Copy hex" Clicked="OnCopyHex" BackgroundColor="#6B7280" TextColor="White" />
            </HorizontalStackLayout>

            <Label Text="Memory" FontAttributes="Bold" />
            <!-- Which pages are writable, behind the password, locked, one-time or fixed (MemoryMapView) -->
            <Label x:Name="MemoryOverview" FontSize="13" LineHeight="1.2" />
            <Label x:Name="MemoryLabel" FontFamily="monospace" FontSize="12" LineBreakMode="CharacterWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
