<?xml version="1.0" encoding="utf-8" ?>
<pages:CodeGeneratorPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TagBuddy.Controls"
             xmlns:pages="clr-namespace:TagBuddy.Pages"
             x:Class="TagBuddy.Pages.GeneratePage"
             Title="Generate">
    <ScrollView x:Name="Scroller">
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Barcode type" FontAttributes="Bold" />
            <Picker x:Name="FormatPicker"
                    Title="Select a barcode type"
                    SelectedIndexChanged="OnFormatChanged" />
            <Label x:Name="HintLabel" FontSize="12" TextColor="Gray" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Text" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Paste" Clicked="OnPaste"
                        BackgroundColor="#6B7280" TextColor="White" Padding="14,6" MinimumHeightRequest="36" FontSize="13"
                        ToolTipProperties.Text="Replace the text with the clipboard" />
            </Grid>
            <Entry x:Name="ValueEntry"
                   Placeholder="Type the text to encode"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="OnValueChanged" />

            <Label x:Name="ErrorLabel"
                   TextColor="#DC2626"
                   FontSize="13"
                   IsVisible="False" />

            <Border x:Name="Card"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeThickness="1"
                    Padding="0"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCodeTapped" />
                </Border.GestureRecognizers>
                <!-- The exported image itself, rendered live, so the preview is exactly what gets shared -->
                <controls:PreviewView x:Name="PreviewImage" HorizontalOptions="Fill" InputTransparent="True"
                                     SizeChanged="OnPreviewSizeChanged" />
            </Border>

            <!-- Text printed under the code in shared/saved images; follows the content until edited -->
            <pages:CaptionSection x:Name="CaptionArea" IsVisible="False" ResetText="Same as text"
                                  Changed="OnCaptionChanged" OpenChanged="OnCaptionOpenChanged" />

            <HorizontalStackLayout x:Name="Actions" HorizontalOptions="Center" IsVisible="False">
                <Button Style="{StaticResource PrimaryIconButton}" ImageSource="ic_bookmark.png"
                        Clicked="OnAddFavorite" SemanticProperties.Description="Save" ToolTipProperties.Text="Save" />
                <Button Style="{StaticResource IconButton}" ImageSource="ic_share.png"
                        Clicked="OnShare" SemanticProperties.Description="Share image" ToolTipProperties.Text="Share image" />
                <Button Style="{StaticResource IconButton}" ImageSource="ic_save.png"
                        Clicked="OnSaveImage" SemanticProperties.Description="Save image to gallery" ToolTipProperties.Text="Save image to gallery" />
                <Button x:Name="OpenLinkButton" Style="{StaticResource LinkIconButton}" ImageSource="ic_open.png"
                        Clicked="OnOpenLink" SemanticProperties.Description="Open link" ToolTipProperties.Text="Open link" IsVisible="False" />
            </HorizontalStackLayout>

            <!-- Spare room at the end while the caption section is open: when the card shrinks the page
                 would otherwise run out of scroll range and the controls would be pushed down under the finger. -->
            <ContentView x:Name="BottomSpacer" HeightRequest="0" />

        </VerticalStackLayout>
    </ScrollView>
</pages:CodeGeneratorPage>
