	<application android:usesCleartextTraffic="true" android:extractNativeLibs="false" android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">
		<!-- Disable EmojiCompat's auto-initializer. Its text watcher crashes ("end should be < than charSequence length")
		     on backspace in the hidden byte-typing inputs, which rewrite their own text each keystroke. Emoji still render
		     natively on modern Android; only the back-compat processing is turned off. -->
		<provider android:name="androidx.startup.InitializationProvider"
		          android:authorities="${applicationId}.androidx-startup"
		          android:exported="false"
		          tools:node="merge">
			<meta-data android:name="androidx.emoji2.text.EmojiCompatInitializer" tools:node="remove" />
		</provider>
	</application>
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<uses-permission android:name="android.permission.NFC" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-feature android:name="android.hardware.nfc" android:required="false" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
	<!-- Android 11+ hides other apps unless declared here, and MAUI's Browser and Launcher check for one before opening
